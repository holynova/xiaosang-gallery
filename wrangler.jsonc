{
  "$schema": "https://unpkg.com/wrangler@4.128.0/config-schema.json",
  "name": "xiaosang-gallery",
  "account_id": "ef7863c4de93e71c3496f940c8ab4865",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "xiaosang.cc/xiaosang-gallery",
      "zone_id": "a9ae8ed6c9a473e6c79daa58b29e8b12"
    },
    {
      "pattern": "xiaosang.cc/xiaosang-gallery/*",
      "zone_id": "a9ae8ed6c9a473e6c79daa58b29e8b12"
    }
  ]
}
